# This runnable build is a LOCAL DEMO. Production mode deliberately fails closed.
MDP_MODE=demo
MDP_DATABASE=.local/mdp.sqlite
# Future production adapter (not connected by this demo)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PAYMENT_WEBHOOK_SECRET=
DOCUMENT_ENCRYPTION_KEY=
MALWARE_SCANNER_URL=
OTP_PROVIDER_API_KEY=

# Generated locally by scripts/init-demo.mjs; never use NEXT_PUBLIC for this key.
MDP_LOCAL_VAULT_KEY=

# Server-only verified founder UUID. Required to review staff personas in /demo.
# Missing configuration denies staff previews; never prefix with NEXT_PUBLIC_.
MD_ONE_FOUNDER_USER_ID=

# Durable encrypted synthetic demo state; server-only 32-byte hex secret.
# Configure matching SHA-256 in private.showcase_config before deploying.
MD_ONE_DEMO_STATE_KEY=
